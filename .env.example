# Creative Advs CRM — server settings.
# On Hostinger, enter these in hPanel → your Node.js app → Environment variables.
# On your own computer, copy this file to ".env" and fill it in.

# MySQL database (hPanel → Databases → MySQL Databases)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_crm
DB_USER=u123456789_crmuser
DB_PASSWORD=CHANGE_ME

# Timezone used for "today", overdue checks and timestamps.
TIMEZONE=Asia/Kolkata

# Redirect http:// to https:// once SSL is active (true / false).
FORCE_HTTPS=false

# Show the maintenance page to everyone except signed-in admins (true / false).
MAINTENANCE=false

# Show real database errors in API responses. Only while debugging.
DEBUG=false

# Optional. Hostinger sets PORT automatically.
# PORT=3000
# SESSION_LIFETIME=43200     # idle timeout, seconds (12 hours)
# SESSION_ABSOLUTE=604800    # maximum session age, seconds (7 days)
# TRUST_PROXY=1              # reverse proxies in front of the app
